<%- include('include/_baristaHeader') %>

<% function getOrderTime(timestamp) {
  if (!timestamp) return "";
  const atMatch = timestamp.match(/ at ([^/]+)/);
  if (atMatch && atMatch[1]) {
    return atMatch[1];
  }
  const slashIndex = timestamp.indexOf("/");
  if (slashIndex > -1) {
    return timestamp.substring(0, slashIndex);
  }
  const timeMatch = timestamp.match(/(\d{1,2}:\d{2}\s*(?:am|pm))/i);
  if (timeMatch) {
    return timeMatch[1];
  }
  return timestamp;
} %>

<div id="mainContent">
  <div class="barista-header">
    <h1 class="page-title">Completed Orders</h1>
    <% let totalCompleted = 0; %>
    <% const today = new Date().toLocaleDateString('en-US'); %>
    <% for (let order of orders){ %>
    <% if(order.complete === true && order.timestamp){ %>
    <% const orderDate = order.timestamp.split("/")[0]; %>
    <% if(orderDate === today){ %>
    <% totalCompleted++; %>
    <% } %>
    <% } %>
    <% } %>
    <p class="total-count">Total Orders Completed Today: <%= totalCompleted %></p>
    
    <!-- Search Bar -->
    <div class="search-container">
      <input type="text" id="orderSearch" placeholder="Search by room or teacher name..." class="search-input">
      <button id="clearSearch" class="clear-search-btn">Clear</button>
    </div>
    
    <a href="/barista/cancelledOrders"
      ><input type="submit" value="View Cancelled Orders"
    /></a>
  </div>

  <div class="orders-container">
    <table class="orders-table" id="orderTable">
      <thead>
        <tr>
          <th>Room</th>
          <th>Teacher</th>
          <th>Drink</th>
          <th>Temp</th>
          <th>Ingredients</th>
          <th>Decaf</th>
          <th>Special Instructions</th>
          <th>Order Time</th>
          <th>Duration</th>
          <th>Cost to Make</th>
          <th>Sale Price</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% let count = 0; %> <% for (let order of orders){ %> <%
        if(order.complete === true){ %> <% let showButtons = true; %> <% for(let
        i = 0; i < order.drinks.length; i++){ %> <% let tempDrink =
        drinkMap.get(count)[i]; %>
        <tr
          class="order-row <%= i === 0 ? 'first-drink' : 'additional-drink' %>"
        >
          <td><%=order.room%></td>
          <td>
            <%= order.name && order.name.trim() ? order.name :
            order.email.split('@')[0] %> <% if(order.isAdmin) { %>
            <span style="color: red"> Admin</span>
            <% } %>
          </td>
          <td><%=tempDrink.name%></td>
          <td>
            <span class="temp-badge <%=tempDrink.temp.toLowerCase()%>"
              ><%=tempDrink.temp%></span
            >
          </td>
          <td><%=tempDrink.ingredients%></td>
          <td><%=tempDrink.caffeinated ? "No" : "Yes"%></td>
          <td><%=tempDrink.instructions%></td>
          <td><%=getOrderTime(order.timestamp)%></td>
          <td><%=order.timer && order.timer !== 'uncompleted' ? order.timer + ' min' : 'N/A'%></td>
          <td>$<%=order.costToMake != null ? order.costToMake.toFixed(2) : '0.00'%></td>
          <td>$<%=order.salePrice != null ? order.salePrice.toFixed(2) : '0.00'%></td>
          <% if(showButtons === true) { %>
          <td>
            <button
              class="action-button incomplete incompleteButton"
              value="<%=order.id%>"
            >
              Mark Incomplete
            </button>
          </td>
          <% showButtons = false; %> <% } else { %>
          <td class="part-of-order">Part of above order</td>
          <% } %>
        </tr>
        <% } %> <% } %> <% count++; %> <% } %>
      </tbody>
    </table>
  </div>
</div>

<style>
  /* Same styles as barista.ejs */
  /* ...existing styles from barista.ejs... */

  /* Additional style for incomplete button */
  .action-button.incomplete {
    background: var(--coffee-medium);
    color: white;
  }

  .order-row td {
    padding: 1rem;
    border-top: 2px solid white;
    border-bottom: 2px solid white;
    color: var(--coffee-dark);
    font-weight: 500;
  }

  /* Make certain columns stand out */
  .order-row td:nth-child(1), /* Room number */
  .order-row td:nth-child(3), /* Drink name */
  .order-row td:nth-child(8), /* Order Time */
  .order-row td:nth-child(9), /* Duration */
  .order-row td:nth-child(10), /* Cost to Make */
  .order-row td:nth-child(11) { /* Sale Price */
    font-weight: 600;
    color: #2c1810;
  }

  .part-of-order {
    color: var(--coffee-medium);
    font-style: italic;
  }

  /* Make completed orders slightly muted but still readable */
  .order-row {
    opacity: 0.85;
  }

  .order-row:hover {
    opacity: 1;
  }

  .total-count {
    font-size: 1.2rem;
    font-weight: bold;
    color: var(--coffee-dark);
    margin: 0.5rem 0;
  }

  /* Search Bar Styles */
  .search-container {
    display: flex;
    align-items: center;
    margin: 1rem 0;
    gap: 0.5rem;
  }

  .search-input {
    padding: 0.5rem 1rem;
    border: 2px solid var(--coffee-light);
    border-radius: 8px;
    font-size: 1rem;
    width: 300px;
    transition: border-color 0.3s ease;
  }

  .search-input:focus {
    outline: none;
    border-color: var(--coffee-medium);
  }

  .clear-search-btn {
    padding: 0.5rem 1rem;
    background: var(--coffee-medium);
    color: white;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.9rem;
    transition: background-color 0.3s ease;
  }

  .clear-search-btn:hover {
    background: var(--coffee-dark);
  }
</style>

<script src="/js/completedOrders.js"></script>

<%- include('include/_footer') %>

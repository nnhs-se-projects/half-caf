<%- include('include/_teacherHeader') %>

<div id="mainContent">
  <div
    id="order-success"
    role="status"
    aria-live="polite"
    style="
      background: #e6ffed;
      border: 1px solid #9be6a1;
      padding: 1rem;
      border-radius: 8px;
      margin: 1rem 0;
      color: #065f15;
    "
  >
    <p>
      Your order was placed successfully — thank you! You can view your order or
      close this page.
    </p>
    <p><strong>Order Total: $<%= totalPrice.toFixed(2) %></strong></p>
  </div>
  <main>
    <div>
      <h1>Thanks for supporting the Half Caf!</h1>
      <div
        style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: center"
      >
        <a href="/teacher/outgoingOrders">
          <input type="submit" value="View Order" />
        </a>
        <button
          type="button"
          onclick="downloadReceipt()"
          style="
            padding: 0.5rem 1rem;
            background-color: #4caf50;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 1rem;
          "
        >
          📄 Download Receipt
        </button>
        <a href="https://forms.gle/S59C8d64LnrJvpRz6" target="_blank">
          Please click this link to fill out this survey to tell us about your
          experience ordering through the app.
        </a>
      </div>
      <img src="<%=image%>" id="image" size="500px" />
      <label for="image"><%=joke%></label>
    </div>
  </main>
</div>

<%- include('include/_footer') %>

<script>
  function downloadReceipt() {
    const orderId = "<%= orderId %>";

    if (!orderId) {
      alert("Order ID not found. Please try again.");
      return;
    }

    // Download the PDF
    window.location.href = `/teacher/receipt/${orderId}`;
  }
</script>

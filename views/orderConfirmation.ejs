<%- include('include/_teacherHeader') %>

<div id="mainContent">
  <div
    id="order-success"
    role="status"
    aria-live="polite"
    style="
      background: #e6ffed;
      border: 1px solid #9be6a1;
      padding: 1rem;
      border-radius: 8px;
      margin: 1rem 0;
      color: #065f15;
    "
  >
    <p>Your order was placed successfully — thank you! You can view your order or close this page.</p>
    <p><strong>Order Total: $<%= totalPrice.toFixed(2) %></strong></p>
  </div>
  <main>
    <div>
      <h1>Thanks for supporting the Half Caf!</h1>
      <h1>
        <a href="/teacher/outgoingOrders">
          <input type="submit" value="View Order" />
        </a>
        <img src="<%=image%>" id="image" size="500px" />
        <label for="image"><%=joke%></label>
      </h1>
    </div>
    <section class="feedback-section">
      <h2>How was your order?</h2>
      <% if (feedbackSuccess) { %>
      <div class="feedback-success" role="status" aria-live="polite">
        Thanks for the feedback!
      </div>
      <% } %>
      <% if (!latestOrderId) { %>
      <p class="feedback-muted">No recent order found to rate.</p>
      <% } else if (feedbackSubmitted) { %>
      <p class="feedback-muted">You already submitted feedback for this order.</p>
      <% } else { %>
      <form class="feedback-form" action="/teacher/feedback" method="POST">
        <input type="hidden" name="orderId" value="<%= latestOrderId %>" />
        <fieldset class="rating-group">
          <legend>Rating</legend>
          <div class="stars" role="radiogroup" aria-label="Rating from 1 to 5">
            <input type="radio" id="star5" name="rating" value="5" required />
            <label for="star5" aria-label="5 stars">&#9733;</label>
            <input type="radio" id="star4" name="rating" value="4" />
            <label for="star4" aria-label="4 stars">&#9733;</label>
            <input type="radio" id="star3" name="rating" value="3" />
            <label for="star3" aria-label="3 stars">&#9733;</label>
            <input type="radio" id="star2" name="rating" value="2" />
            <label for="star2" aria-label="2 stars">&#9733;</label>
            <input type="radio" id="star1" name="rating" value="1" />
            <label for="star1" aria-label="1 star">&#9733;</label>
          </div>
        </fieldset>
        <label class="feedback-label" for="feedback-comment">Tell us more</label>
        <textarea
          id="feedback-comment"
          name="comment"
          rows="5"
          placeholder="Share anything that went well or could be improved..."
          required
        ></textarea>
        <button class="feedback-submit" type="submit">Send feedback</button>
      </form>
      <% } %>
    </section>
  </main>
</div>

<%- include('include/_footer') %>

<style>
  .feedback-section {
    margin: 2rem 0 3rem;
    padding: 1.5rem;
    border-radius: 16px;
    background: #f8f4ef;
    border: 1px solid #e6ddd3;
  }

  .feedback-section h2 {
    margin-top: 0;
    color: #3c2a21;
  }

  .feedback-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .rating-group {
    border: none;
    padding: 0;
    margin: 0;
  }

  .stars {
    display: flex;
    flex-direction: row-reverse;
    justify-content: flex-end;
    gap: 0.25rem;
    font-size: 2rem;
  }

  .stars input {
    position: absolute;
    opacity: 0;
  }

  .stars label {
    cursor: pointer;
    color: #c9b8a8;
  }

  .stars label:hover,
  .stars label:hover ~ label,
  .stars input:focus-visible + label,
  .stars input:checked ~ label {
    color: #f7b731;
  }

  .feedback-label {
    font-weight: 600;
    color: #3c2a21;
  }

  .feedback-form textarea {
    resize: vertical;
    border-radius: 10px;
    border: 1px solid #d6c8bb;
    padding: 0.75rem;
    font-family: inherit;
  }

  .feedback-submit {
    align-self: flex-start;
    background: #c97a3a;
    color: #fff;
    border: none;
    border-radius: 10px;
    padding: 0.75rem 1.5rem;
    cursor: pointer;
    font-weight: 600;
  }

  .feedback-success {
    background: #e6ffed;
    border: 1px solid #9be6a1;
    color: #065f15;
    padding: 0.75rem 1rem;
    border-radius: 10px;
    margin-bottom: 1rem;
  }

  .feedback-muted {
    color: #5c4a3f;
    margin: 0;
  }

</style>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Half Caf</title>
    <link rel="stylesheet" href="/css/pico.min.css" />
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="shortcut icon" type="image/png" href="/img/logo.png" />
    <style>
      @media screen and (max-width: 768px) {
        .full-title {
          display: none;
        }
        #leftTrigger {
          display: none;
        }
      }
      @media screen and (min-width: 769px) {
        .mobile-title {
          display: none;
        }
        /* Updated arrow trigger styling */
        #leftTrigger {
          position: fixed;
          top: 50%;
          left: 20px; /* attached to collapsed sidebar edge */
          transform: translateY(-50%);
          width: 24px;
          height: 24px;
          background: var(--coffee-medium);
          cursor: pointer;
          z-index: 1003; /* Higher than sidebar so it's clickable */
          transition: left 0.3s ease;
          opacity: 0.9;
          border-radius: 4px;
          display: flex;
          align-items: center;
          justify-content: center;
        }
        #leftTrigger span {
          display: block;
          text-align: center;
          color: white;
          line-height: 24px;
          font-size: 14px;
        }
        /* Arrow position is controlled by JS to avoid stale position */
      }
      .header-announcement-section {
        position: fixed;
        top: calc(75px + env(safe-area-inset-top, 0));
        left: 0;
        width: 100%;
        padding: 0.4rem 1rem;
        background: rgba(255, 247, 235, 0.95);
        border-top: 1px solid rgba(60, 42, 33, 0.12);
        border-bottom: 1px solid rgba(60, 42, 33, 0.12);
        font-size: 0.85rem;
        line-height: 1.2;
        color: #3c2a21;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        z-index: 999;
      }
      .header-announcement-item {
        margin-right: 0.35rem;
      }
      @media screen and (max-width: 768px) {
        .header-announcement-section {
          font-size: 0.75rem;
        }
      }
    </style>
  </head>
  <body>
    <div class="container" id="logo">
      <%- include('_header') %>
      <h1 class="indexTopBar">
        <span class="full-title">NNHS Half Caf</span>
        <span class="mobile-title">Half Caf</span>
      </h1>
      <% if (activeAnnouncements && activeAnnouncements.length > 0) { %>
      <div class="header-announcement-section">
        <strong>Announcements:</strong>
        <% activeAnnouncements.forEach((announcement, index) => { %>
        <span class="header-announcement-item">
          <%= announcement.subject %>: <%= announcement.message %><%= index < activeAnnouncements.length - 1 ? ' •' : '' %>
        </span>
        <% }) %>
      </div>
      <% } %>
    </div>
    <!-- Reorder: Place sidebar first, then arrow trigger -->
    <div id="sidebar">
      <a href="/homePopularDrinks">Popular Drinks</a>
      <a href="/homeMenu">Menu</a>
      <a href="/auth">Login</a>
    </div>
    <div id="leftTrigger"><span>&rarr;</span></div>
    <script>
      // Make arrow trigger open sidebar on hover (desktop only)
      if (window.innerWidth > 768) {
        const leftTrigger = document.getElementById("leftTrigger");
        const sidebar = document.getElementById("sidebar");
        let autoCloseTimer;
        if (leftTrigger && sidebar) {
          const collapsedLeft = "20px";
          const expandedLeft = "200px";
          const setTriggerCollapsed = function () {
            leftTrigger.style.left = collapsedLeft;
          };
          const setTriggerExpanded = function () {
            leftTrigger.style.left = expandedLeft;
          };
          const openSidebar = function () {
            sidebar.style.setProperty(
              "transform",
              "translateX(0)",
              "important",
            );
            setTriggerExpanded();
          };
          const scheduleClose = function () {
            clearTimeout(autoCloseTimer);
            autoCloseTimer = setTimeout(function () {
              if (
                !sidebar.matches(":hover") &&
                !leftTrigger.matches(":hover")
              ) {
                sidebar.style.removeProperty("transform");
                setTriggerCollapsed();
              }
            }, 5);
          };
          leftTrigger.addEventListener("mouseenter", function () {
            clearTimeout(autoCloseTimer);
            openSidebar();
          });
          leftTrigger.addEventListener("mouseleave", function () {
            scheduleClose();
          });
          sidebar.addEventListener("mouseenter", function () {
            clearTimeout(autoCloseTimer);
            setTriggerExpanded();
          });
          sidebar.addEventListener("mouseleave", function () {
            scheduleClose();
          });
          leftTrigger.addEventListener("click", function () {
            openSidebar();
            scheduleClose();
          });
          setTriggerCollapsed();
        }
      }
    </script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/notifications.js"></script>
    <!-- Add sw-update to listen for updates -->
    <script src="/js/sw-update.js"></script>
  </body>
</html>

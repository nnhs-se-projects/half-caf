<!-- include header -->
<%- include('include/_adminHeader') %>
<!-- /include header -->

<!-- Main Site -->

<% const selectedScheduleId = selectedSchedule ? selectedSchedule.id : ''; %>
<% const activeScheduleId = activeSchedule ? activeSchedule.id : ''; %>

<div id="mainContent">
  <div class="scheduler-header">
    <h1 class="page-title">Schedule Manager</h1>
  </div>

  <div class="scheduler-container">
    <input type="hidden" id="selectedScheduleId" value="<%=selectedScheduleId%>" />
    <input type="hidden" id="activeScheduleId" value="<%=activeScheduleId%>" />
    
    <div class="schedule-controls">
      <button class="action-button create" onclick="window.location.href='/admin/addSchedule'">
        <span class="button-icon">+</span>
        Create Schedule
      </button>
      
      <div class="active-schedule">
        <span class="label">Active Schedule:</span>
        <span class="value"><%=activeSchedule ? activeSchedule.name : 'No active schedule configured'%></span>
      </div>

      <div class="schedule-selector">
        <label class="label">Select Schedule:</label>
        <div class="select-wrapper">
          <select class="fancy-select" id="schedules">
            <% for (let schedule of schedules) { %>
              <option value="<%=schedule._id%>" <%= schedule.id === selectedScheduleId ? 'selected' : '' %>>
                <%=schedule.name%>
              </option>
            <% } %>
          </select>
        </div>
        <button class="action-button delete" id="deleteBtn">Delete Schedule</button>
      </div>
    </div>

    <div class="periods-section">
      <div class="periods-header">
        <h2 class="section-title">Periods</h2>
        <% if (role === 'admin' && selectedSchedule) { %>
          <button class="action-button create" id="addPeriodBtn">
            <span class="button-icon">+</span>
            Add Period
          </button>
        <% } %>
      </div>
      <% if (selectedPeriods.length > 0) { %>
        <div class="periods-grid">
          <% for (let period of selectedPeriods) { %>
            <div class="period-card">
              <h3 class="period-name"><%=period.name%></h3>
              <% if(role === 'barista' || role === 'admin') { %>
          <div class="disable-ordering-checkbox">
                <label for="period-<%=period._id%>" class="checkbox-label">
                  Disable Ordering
                <input 
                  type="checkbox" 
                  class="period-checkbox"
                  id="period-<%=period._id%>"
                  data-period-id="<%=period._id%>"
                  <%= period.orderingDisabled ? 'checked' : '' %>
                />
                </label>
              </div>
          <% } %>
              <div class="time-details">
                <div class="time-item">
                  <span class="time-label">Start:</span>
                  <span class="time-value"><%=period.start%></span>
                </div>
                <div class="time-item">
                  <span class="time-label">End:</span>
                  <span class="time-value"><%=period.end%></span>
                </div>
            </div>
            <% if (role === 'admin') { %>
              <div class="period-actions">
                <button
                  class="action-button small edit-period"
                  data-period-id="<%=period._id%>"
                  data-period-name="<%=period.name%>"
                  data-period-start="<%=period.start%>"
                  data-period-end="<%=period.end%>"
                >Edit</button>
                <button
                  class="action-button small delete delete-period"
                  data-period-id="<%=period._id%>"
                  data-period-name="<%=period.name%>"
                >Delete</button>
              </div>
            <% } %>
          </div>
          <% } %>
        </div>
      <% } else { %>
        <div class="period-card empty-state">
          No schedule periods are available yet. Create a schedule to use the scheduler.
        </div>
      <% } %>
  </div>
</div>

<!-- Add Period Modal -->
<div id="addPeriodModal" class="modal">
  <div class="modal-content">
    <div class="modal-header">
      <h2>Add Period</h2>
      <span class="close" data-modal="addPeriodModal">&times;</span>
    </div>
    <form id="addPeriodForm">
      <div class="modal-body">
        <div class="form-group">
          <label for="addPeriodName">Period Name</label>
          <input type="text" id="addPeriodName" placeholder="Before School" required />
        </div>
        <div class="form-group">
          <label for="addPeriodStart">Start Time</label>
          <input type="time" id="addPeriodStart" required />
        </div>
        <div class="form-group">
          <label for="addPeriodEnd">End Time</label>
          <input type="time" id="addPeriodEnd" required />
        </div>
        <p class="modal-hint">
          Ordering is automatically disabled for the last 10 minutes of every
          period, and stays off until the next period begins.
        </p>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn-cancel" data-modal="addPeriodModal">Cancel</button>
        <button type="submit" class="btn-submit">Add Period</button>
      </div>
    </form>
  </div>
</div>

<!-- Edit Period Modal -->
<div id="editPeriodModal" class="modal">
  <div class="modal-content">
    <div class="modal-header">
      <h2>Edit Period</h2>
      <span class="close" data-modal="editPeriodModal">&times;</span>
    </div>
    <form id="editPeriodForm">
      <div class="modal-body">
        <input type="hidden" id="editPeriodId" />
        <div class="form-group">
          <label for="editPeriodName">Period Name</label>
          <input type="text" id="editPeriodName" required />
        </div>
        <div class="form-group">
          <label for="editPeriodStart">Start Time</label>
          <input type="time" id="editPeriodStart" required />
        </div>
        <div class="form-group">
          <label for="editPeriodEnd">End Time</label>
          <input type="time" id="editPeriodEnd" required />
        </div>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn-cancel" data-modal="editPeriodModal">Cancel</button>
        <button type="submit" class="btn-submit">Save Changes</button>
      </div>
    </form>
  </div>
</div>

<style>

.period-name {
  text-wrap: nowrap;
}
.checkbox-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.5rem;
  cursor: pointer;
}


  input[type="checkbox"]:checked {
    background: var(--accent);
    border-color: var(--accent);
  }

  input[type="checkbox"]:checked::after {
    content: "✓";
    color: white;
    position: absolute;
    left: 50%;
    top: 45%;
    transform: translate(-50%, -50%);
    font-size: 14px;
    font-weight: bold;
  }

  input[type="checkbox"] {
    outline: 2px solid var(--coffee-light);
    border-radius: 4px;
    width: 20px;
    height: 20px;
    cursor: pointer;
  }

  .scheduler-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  .scheduler-header {
    margin-bottom: 2rem;
  }

  .page-title {
    color: var(--coffee-dark);
    font-size: 2.5rem;
    margin: 0;
  }

  .schedule-controls {
    background: white;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 4px 24px rgba(60, 42, 33, 0.1);
    margin-bottom: 2rem;
  }

  .active-schedule {
    margin: 1.5rem 0;
    padding: 1rem;
    background: var(--cream);
    border-radius: 8px;
  }

  .schedule-selector {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .fancy-select {
    flex: 1;
    padding: 0.75rem;
    border: 2px solid var(--coffee-light);
    border-radius: 8px;
    font-size: 1rem;
    color: var(--coffee-dark);
    background: white;
    cursor: pointer;
  }

  .action-button {
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .action-button.create {
    background: var(--accent);
    color: white;
  }

  .action-button.delete {
    background: #ff6b6b;
    color: white;
  }

  .action-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(60, 42, 33, 0.2);
  }

  .button-icon {
    margin-right: 0.5rem;
    font-size: 1.2rem;
  }

  .label {
    font-weight: 600;
    color: var(--coffee-medium);
    margin-right: 0.5rem;
  }

  .value {
    color: var(--coffee-dark);
    font-weight: 500;
  }

  .periods-section {
    margin-top: 2rem;
  }

  .section-title {
    color: var(--coffee-dark);
    margin-bottom: 1rem;
  }

  .periods-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .period-card {
    background: white;
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: 0 4px 24px rgba(60, 42, 33, 0.1);
    transition: all 0.2s ease;
  }

  .period-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 32px rgba(60, 42, 33, 0.15);
  }

  .empty-state {
    color: var(--coffee-medium);
    text-align: center;
  }

  .period-name {
    color: var(--coffee-dark);
    margin: 0 0 1rem 0;
    font-size: 1.5rem;
  }

  .time-details {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .time-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem;
    background: var(--cream);
    border-radius: 8px;
  }

  .time-label {
    color: var(--coffee-medium);
    font-weight: 600;
  }

  .time-value {
    color: var(--coffee-dark);
    font-weight: 500;
  }

  .periods-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .period-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .action-button.small {
    padding: 0.4rem 0.9rem;
    font-size: 0.85rem;
  }

  .action-button.edit-period {
    background: var(--coffee-medium);
    color: white;
  }

  /* --- modals: same pattern as the drinks and ingredients pages --- */
  .modal {
    display: none;
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
  }

  .modal.show {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .modal-content {
    background-color: white;
    border-radius: 12px;
    width: 90%;
    max-width: 500px;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem;
    border-bottom: 1px solid #e0e0e0;
    background: var(--coffee-dark, #3c2a21);
    color: white;
    border-radius: 12px 12px 0 0;
  }

  .modal-header h2 {
    margin: 0;
    font-size: 1.5rem;
    color: white;
  }

  .close {
    color: white;
    font-size: 2rem;
    font-weight: bold;
    cursor: pointer;
    line-height: 1;
    transition: color 0.2s ease;
  }

  .close:hover {
    color: var(--accent, #f5ae43);
  }

  .modal-body {
    padding: 2rem;
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  .form-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
    color: var(--coffee-dark, #3c2a21);
  }

  .form-group input {
    width: 100%;
    padding: 0.6rem;
    border: 1px solid #ccc;
    border-radius: 6px;
  }

  .modal-hint {
    margin: 0;
    font-size: 0.85rem;
    color: var(--coffee-medium, #6b4f3f);
  }

  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 1rem;
    padding: 1.5rem;
    border-top: 1px solid #e0e0e0;
    background: #f8f9fa;
    border-radius: 0 0 12px 12px;
  }

  .btn-cancel,
  .btn-submit {
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: 6px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-cancel {
    background: #e0e0e0;
    color: var(--coffee-dark, #3c2a21);
  }

  .btn-submit {
    background: var(--accent);
    color: white;
  }

  @media screen and (max-width: 768px) {
    .periods-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<script src="/js/periodTime.js"></script>
<script src="/js/scheduler.js"></script>

<%- include('include/_footer') %>

